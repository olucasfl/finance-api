generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id                        String                     @id @default(uuid())
  name                      String
  email                     String                     @unique
  password                  String
  createdAt                 DateTime                   @default(now())
  updatedAt                 DateTime                   @updatedAt
  refreshSessions           RefreshSession[]
  emailVerificationToken    String?                    @unique
  emailVerificationTokenExpires DateTime?
  emailVerified             Boolean                    @default(false)
  passwordResetExpires      DateTime?
  passwordResetToken        String?
  pendingEmail              String?
  pendingEmailToken         String?                    @unique
  pendingEmailExpires       DateTime?
  isAdmin                   Boolean                    @default(false)
  completedConsecrationDays ConsecrationCompletedDay[]
  consecrations             ConsecrationProgress[]
  conversations             Conversation[]
  rosarySessions            RosarySession[]
  spiritualStats            SpiritualStats?
  activities                UserActivity[]
  readingProgress           ReadingProgress[]
  pushSubscriptions         PushSubscription[]
  notifications             Notification[]
}

model PushSubscription {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  endpoint  String   @unique
  p256dh    String
  auth      String
  timezone  String   @default("UTC")
  createdAt DateTime @default(now())

  @@index([userId])
}

// Uma linha por dispositivo/login ativo. Antes disso o refresh token
// vivia num campo único em User — logar num segundo aparelho sobrescrevia
// o token do primeiro, derrubando a sessão dele silenciosamente. Agora
// cada login cria sua própria sessão, e renovar uma não mexe nas outras.
model RefreshSession {
  id          String   @id @default(uuid())
  userId      String
  tokenHash   String
  createdAt   DateTime @default(now())
  expiresAt   DateTime
  userAgent   String?
  deviceLabel String?
  ipAddress   String?
  location    String?
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model UserActivity {
  id        String   @id @default(uuid())
  userId    String
  type      String
  action    String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model ConsecrationProgress {
  id        String   @id @default(uuid())
  startDate DateTime
  userId    String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model ConsecrationStage {
  id          String            @id @default(uuid())
  title       String
  description String?
  order       Int
  days        Int
  daysContent ConsecrationDay[]
}

model ConsecrationDay {
  id        String            @id @default(uuid())
  dayNumber Int
  title     String?
  stageId   String
  stage     ConsecrationStage @relation(fields: [stageId], references: [id], onDelete: Cascade)
  prayers   DayPrayer[]
}

model Prayer {
  id      String      @id @default(uuid())
  title   String
  content String
  days    DayPrayer[]
}

model DayPrayer {
  id       String          @id @default(uuid())
  order    Int
  dayId    String
  prayerId String
  day      ConsecrationDay @relation(fields: [dayId], references: [id], onDelete: Cascade)
  prayer   Prayer          @relation(fields: [prayerId], references: [id])
}

model ConsecrationCompletedDay {
  id        String   @id @default(uuid())
  dayNumber Int
  userId    String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model PrayerCategory {
  id        String          @id @default(uuid())
  name      String
  slug      String          @unique
  createdAt DateTime        @default(now())
  prayers   GeneralPrayer[]
}

model GeneralPrayer {
  id         String         @id @default(uuid())
  title      String
  content    String
  categoryId String
  createdAt  DateTime       @default(now())
  category   PrayerCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
}

model RosarySession {
  id             String    @id @default(uuid())
  userId         String
  type           String    @default("gozosos")
  currentStep    Int       @default(0)
  elapsedSeconds Int       @default(0)
  completed      Boolean   @default(false)
  startedAt      DateTime  @default(now())
  finishedAt     DateTime?
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, type, completed])
}

model SpiritualStats {
  id             String    @id @default(uuid())
  userId         String    @unique
  rosariesPrayed Int       @default(0)
  prayersPrayed  Int       @default(0)
  prayerStreak   Int       @default(0)
  lastPrayerDate DateTime?
  lastLoginDate  DateTime?
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Conversation {
  id          String    @id @default(uuid())
  userId      String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  title       String?
  hasMessages Boolean   @default(false)
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages    Message[]
}

model Message {
  id             String       @id @default(uuid())
  role           String
  content        String
  conversationId String
  createdAt      DateTime     @default(now())
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
}

// Tipo de leitura contínua que a Home usa pra sugerir "volte de onde parou".
enum ReadingKind {
  BIBLE
  CATECHISM
}

// Última posição de leitura da pessoa em cada frente (Bíblia, Catecismo).
// Só marca ONDE parou — uma linha por (usuário, tipo), sempre sobrescrita.
// `reference` é o ponteiro que a UI usa pra navegar (ex.: "genesis/3" ou
// a página do PDF do Catecismo); `label` é o texto amigável ("Gênesis 3").
// Tabela nova e isolada — não altera nada do que já existe.
model ReadingProgress {
  id        String      @id @default(uuid())
  userId    String
  kind      ReadingKind
  reference String
  label     String
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, kind])
  @@index([userId])
}

// De onde a notificação veio: um envio do admin (CAMPAIGN) ou uma
// regra automática (RULE), como "terço não terminado".
enum NotificationSource {
  CAMPAIGN
  RULE
}

// Registro do envio feito pelo admin — agrupa as Notifications geradas
// e guarda os contadores (alvo/enviado/falhou) pro painel. Expira em 15
// dias, igual aos itens; um cron limpa as vencidas.
model NotificationCampaign {
  id         String         @id @default(uuid())
  title      String
  body       String?
  url        String?
  audience   String         @default("ALL") // "ALL" | "SPECIFIC"
  createdBy  String?
  createdAt  DateTime       @default(now())
  expiresAt  DateTime
  targeted   Int            @default(0)
  pushSent   Int            @default(0)
  pushFailed Int            @default(0)
  notifications Notification[]

  @@index([expiresAt])
}

// Um item na "caixa de entrada" (sino) de cada usuário. Toda notificação
// vira uma linha por pessoa; quem ativou push também recebe fora do app.
// `seenAt` controla o badge do sino; `expiresAt` (criadaEm + 15 dias)
// tira do sino e do painel; um cron apaga as vencidas.
model Notification {
  id         String                @id @default(uuid())
  userId     String
  user       User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  title      String
  body       String?
  url        String?
  source     NotificationSource    @default(CAMPAIGN)
  campaignId String?
  campaign   NotificationCampaign? @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  ruleKey    String?
  pushSent   Boolean               @default(false)
  createdAt  DateTime              @default(now())
  seenAt     DateTime?
  expiresAt  DateTime

  @@index([userId, expiresAt])
  @@index([userId, seenAt])
  @@index([expiresAt])
}

// Regras de notificação automática (terço não terminado, liturgia, etc.).
// O texto e o liga/desliga ficam aqui (editáveis no admin); QUANDO e PRA
// QUEM disparar é lógica de código, por `key`. Usa {count} no corpo pra
// interpolar valores (ex.: dias de sequência).
model NotificationRule {
  key       String   @id @default(uuid())
  enabled   Boolean  @default(true)
  title     String
  body      String?
  url       String?
  hour      Int?     // hora local (0-23) das regras por horário
  condition String?  // "ROSARY_UNFINISHED" | "STREAK_AT_RISK" | null (=diária no horário)
  updatedAt DateTime @updatedAt
}
