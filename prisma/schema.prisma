generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id String @id @default(uuid())
  name String 
  email String @unique
  password String 
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  refreshToken String?

  budgets Budget[]
}

model Budget {
  id String @id @default(uuid())
  name String
  limit Float
  createdAt DateTime @default(now())

  userId String
  user User @relation(fields: [userId], references: [id])

  expenses Expense[]
}

model Expense {
  id String @id @default(uuid())
  title String
  amount Float
  createdAt DateTime @default(now())

  budgetId String
  budget Budget @relation(fields: [budgetId], references: [id], onDelete: Cascade)
}
