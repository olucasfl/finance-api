generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id                        String                     @id @default(uuid())
  name                      String
  email                     String                     @unique
  password                  String
  createdAt                 DateTime                   @default(now())
  updatedAt                 DateTime                   @updatedAt
  refreshToken              String?
  emailVerificationToken    String?
  emailVerified             Boolean                    @default(false)
  passwordResetExpires      DateTime?
  passwordResetToken        String?
  isAdmin                   Boolean                    @default(false)
  bolaoPoints               Int                        @default(0)
  cravadas                  Int                        @default(0)
  budgets                   Budget[]
  completedConsecrationDays ConsecrationCompletedDay[]
  consecrations             ConsecrationProgress[]
  conversations             Conversation[]
  rosarySessions            RosarySession[]
  spiritualStats            SpiritualStats?
  activities                UserActivity[]
  journeyMembers            JourneyMember[]
  journeyIntents            JourneyPrayerIntent[]
}

model UserActivity {
  id        String   @id @default(uuid())
  userId    String
  type      String
  action    String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Budget {
  id        String    @id @default(uuid())
  name      String
  limit     Float
  createdAt DateTime  @default(now())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expenses  Expense[]
}

model Expense {
  id            String        @id @default(uuid())
  title         String
  amount        Float
  createdAt     DateTime      @default(now())
  budgetId      String
  expenseDate   DateTime      @default(now())
  category      Category
  paymentMethod PaymentMethod
  budget        Budget        @relation(fields: [budgetId], references: [id], onDelete: Cascade)
}

model ConsecrationProgress {
  id        String   @id @default(uuid())
  startDate DateTime
  userId    String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model ConsecrationStage {
  id          String            @id @default(uuid())
  title       String
  description String?
  order       Int
  days        Int
  daysContent ConsecrationDay[]
}

model ConsecrationDay {
  id        String            @id @default(uuid())
  dayNumber Int
  title     String?
  stageId   String
  stage     ConsecrationStage @relation(fields: [stageId], references: [id], onDelete: Cascade)
  prayers   DayPrayer[]
}

model Prayer {
  id      String      @id @default(uuid())
  title   String
  content String
  days    DayPrayer[]
}

model DayPrayer {
  id       String          @id @default(uuid())
  order    Int
  dayId    String
  prayerId String
  day      ConsecrationDay @relation(fields: [dayId], references: [id], onDelete: Cascade)
  prayer   Prayer          @relation(fields: [prayerId], references: [id])
}

model ConsecrationCompletedDay {
  id        String   @id @default(uuid())
  dayNumber Int
  userId    String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model PrayerCategory {
  id        String          @id @default(uuid())
  name      String
  slug      String          @unique
  createdAt DateTime        @default(now())
  prayers   GeneralPrayer[]
}

model GeneralPrayer {
  id         String         @id @default(uuid())
  title      String
  content    String
  categoryId String
  createdAt  DateTime       @default(now())
  category   PrayerCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
}

model RosarySession {
  id          String    @id @default(uuid())
  userId      String
  currentStep Int       @default(0)
  completed   Boolean   @default(false)
  startedAt   DateTime  @default(now())
  finishedAt  DateTime?
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model SpiritualStats {
  id             String    @id @default(uuid())
  userId         String    @unique
  rosariesPrayed Int       @default(0)
  prayersPrayed  Int       @default(0)
  prayerStreak   Int       @default(0)
  lastPrayerDate DateTime?
  lastLoginDate  DateTime?
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Conversation {
  id          String    @id @default(uuid())
  userId      String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  title       String?
  hasMessages Boolean   @default(false)
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages    Message[]
}

model Message {
  id             String       @id @default(uuid())
  role           String
  content        String
  conversationId String
  createdAt      DateTime     @default(now())
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
}

model WeeklyJourneyProgress {

  id String @id @default(uuid())

  memberId String

  weekKey String

  rosariesCompleted Int @default(0)

  goalReached Boolean @default(false)

  rewardCollected Boolean @default(false)

  createdAt DateTime @default(now())

  member JourneyMember @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@unique([memberId, weekKey])

}

model JourneyMember {

  id String @id @default(uuid())

  journeyId String

  userId String

  role JourneyRole

  totalPoints Int @default(0)

  currentStreak Int @default(0)

  bestStreak Int @default(0)

  createdAt DateTime @default(now())

  journey PrayerJourney @relation(fields: [journeyId], references: [id], onDelete: Cascade)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  weeklyProgress WeeklyJourneyProgress[]

  @@unique([journeyId, userId])

}

model PrayerJourney {

  id String @id @default(uuid())

  createdAt DateTime @default(now())

  members JourneyMember[]
  intents JourneyPrayerIntent[]

}

model JourneyPrayerIntent {

  id String @id @default(uuid())

  journeyId String

  userId String

  text String

  weekKey String

  createdAt DateTime @default(now())

  journey PrayerJourney @relation(fields: [journeyId], references: [id], onDelete: Cascade)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

}

enum JourneyRole {

  OWNER

  MEMBER

}

enum PaymentMethod {
  CASH
  CREDIT_CARD
  DEBIT_CARD
  BANK_TRANSFER
  PIX
  OTHER
}

enum Category {
  FOOD
  TRANSPORT
  ENTERTAINMENT
  HEALTH
  BILLS
  EDUCATION
  TRAVEL
  RENT
  SHOPPING
  INVESTMENTS
  SUBSCRIPTIONS
  OTHER
}

// ============================================================
// CRAVOU! — Bolão Copa do Mundo 2026
// ============================================================

model CravouMatch {
  id                String             @id @default(uuid())
  externalId        String             @unique
  phase             String
  groupName         String?
  groupRound        Int?               // 1, 2 ou 3 (fase de grupos)
  homeTeam          String
  awayTeam          String
  homeScore         Int?
  awayScore         Int?
  penaltyWinner     String?            // time vencedor nos pênaltis (mata-mata)
  matchDate         DateTime
  stadium           String?
  status            String             @default("upcoming")
  predictionsLocked Boolean            @default(false)
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  predictions       CravouPrediction[]
}

// ─── Classificação da Fase de Grupos ────────────────────────────────────────

model CravouGroupStanding {
  id             String   @id @default(uuid())
  group          String   // "A" até "L"
  teamName       String
  matchesPlayed  Int      @default(0)
  wins           Int      @default(0)
  draws          Int      @default(0)
  losses         Int      @default(0)
  goalsFor       Int      @default(0)
  goalsAgainst   Int      @default(0)
  goalDifference Int      @default(0)
  points         Int      @default(0)
  position       Int?     // 1-4, preenchido quando o grupo termina
  isQualified    Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([group, teamName])
}

// ─── Chaveamento do Mata-Mata ────────────────────────────────────────────────

model CravouBracketSlot {
  id         String   @id @default(uuid())
  round      String   // "round_of_32"|"round_of_16"|"quarterfinal"|"semifinal"|"third_place"|"final"
  slotNumber Int      // sequencial por fase (1-16 no R32, 1-8 no R16, etc.)
  homeDesc   String   // descrição da origem: "1º Grupo A"
  awayDesc   String   // "Melhor Terceiro (C, E ou H)"
  homeTeam   String?  // preenchido quando conhecido
  awayTeam   String?  // preenchido quando conhecido
  winnerTeam String?  // preenchido após o jogo
  loserTeam  String?  // preenchido nas semis (perdedor → disputa 3º lugar)
  matchId    String?  // FK para CravouMatch quando a partida for criada
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([round, slotNumber])
}

model CravouPrediction {
  id            String      @id @default(uuid())
  userId        String
  matchId       String
  homeScore     Int
  awayScore     Int
  penaltyWinner String?     // palpite do classificado nos pênaltis (mata-mata, empate)
  points        Int?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  match         CravouMatch @relation(fields: [matchId], references: [id])

  @@unique([userId, matchId])
}

model CravouGroup {
  id          String              @id @default(uuid())
  name        String
  description String?
  inviteCode  String              @unique @default(cuid())
  ownerId     String
  createdAt   DateTime            @default(now())
  members     CravouGroupMember[]
}

model CravouGroupMember {
  id       String      @id @default(uuid())
  groupId  String
  userId   String
  joinedAt DateTime    @default(now())
  group    CravouGroup @relation(fields: [groupId], references: [id])

  @@unique([groupId, userId])
}
