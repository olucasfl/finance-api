generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                        String                     @id @default(uuid())
  name                      String
  email                     String                     @unique
  password                  String
  createdAt                 DateTime                   @default(now())
  updatedAt                 DateTime                   @updatedAt
  refreshToken              String?
  emailVerificationToken    String?
  emailVerified             Boolean                    @default(false)
  passwordResetExpires      DateTime?
  passwordResetToken        String?
  isAdmin                   Boolean                    @default(false)
  budgets                   Budget[]
  completedConsecrationDays ConsecrationCompletedDay[]
  consecrations             ConsecrationProgress[]
  conversations             Conversation[]
  rosarySessions            RosarySession[]
  spiritualStats            SpiritualStats?
  activities                UserActivity[]
  journeyMembers            JourneyMember[]
  journeyIntents            JourneyPrayerIntent[]
}

model UserActivity {
  id        String   @id @default(uuid())
  userId    String
  type      String
  action    String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Budget {
  id        String    @id @default(uuid())
  name      String
  limit     Float
  createdAt DateTime  @default(now())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expenses  Expense[]
}

model Expense {
  id            String        @id @default(uuid())
  title         String
  amount        Float
  createdAt     DateTime      @default(now())
  budgetId      String
  expenseDate   DateTime      @default(now())
  category      Category
  paymentMethod PaymentMethod
  budget        Budget        @relation(fields: [budgetId], references: [id], onDelete: Cascade)
}

model ConsecrationProgress {
  id        String   @id @default(uuid())
  startDate DateTime
  userId    String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model ConsecrationStage {
  id          String            @id @default(uuid())
  title       String
  description String?
  order       Int
  days        Int
  daysContent ConsecrationDay[]
}

model ConsecrationDay {
  id        String            @id @default(uuid())
  dayNumber Int
  title     String?
  stageId   String
  stage     ConsecrationStage @relation(fields: [stageId], references: [id], onDelete: Cascade)
  prayers   DayPrayer[]
}

model Prayer {
  id      String      @id @default(uuid())
  title   String
  content String
  days    DayPrayer[]
}

model DayPrayer {
  id       String          @id @default(uuid())
  order    Int
  dayId    String
  prayerId String
  day      ConsecrationDay @relation(fields: [dayId], references: [id], onDelete: Cascade)
  prayer   Prayer          @relation(fields: [prayerId], references: [id])
}

model ConsecrationCompletedDay {
  id        String   @id @default(uuid())
  dayNumber Int
  userId    String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model PrayerCategory {
  id        String          @id @default(uuid())
  name      String
  slug      String          @unique
  createdAt DateTime        @default(now())
  prayers   GeneralPrayer[]
}

model GeneralPrayer {
  id         String         @id @default(uuid())
  title      String
  content    String
  categoryId String
  createdAt  DateTime       @default(now())
  category   PrayerCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
}

model RosarySession {
  id          String    @id @default(uuid())
  userId      String
  currentStep Int       @default(0)
  completed   Boolean   @default(false)
  startedAt   DateTime  @default(now())
  finishedAt  DateTime?
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model SpiritualStats {
  id             String    @id @default(uuid())
  userId         String    @unique
  rosariesPrayed Int       @default(0)
  prayersPrayed  Int       @default(0)
  prayerStreak   Int       @default(0)
  lastPrayerDate DateTime?
  lastLoginDate  DateTime?
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Conversation {
  id          String    @id @default(uuid())
  userId      String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  title       String?
  hasMessages Boolean   @default(false)
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages    Message[]
}

model Message {
  id             String       @id @default(uuid())
  role           String
  content        String
  conversationId String
  createdAt      DateTime     @default(now())
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
}

model WeeklyJourneyProgress {

  id String @id @default(uuid())

  memberId String

  weekKey String

  rosariesCompleted Int @default(0)

  goalReached Boolean @default(false)

  rewardCollected Boolean @default(false)

  createdAt DateTime @default(now())

  member JourneyMember @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@unique([memberId, weekKey])

}

model JourneyMember {

  id String @id @default(uuid())

  journeyId String

  userId String

  role JourneyRole

  totalPoints Int @default(0)

  currentStreak Int @default(0)

  bestStreak Int @default(0)

  createdAt DateTime @default(now())

  journey PrayerJourney @relation(fields: [journeyId], references: [id], onDelete: Cascade)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  weeklyProgress WeeklyJourneyProgress[]

  @@unique([journeyId, userId])

}

model PrayerJourney {

  id String @id @default(uuid())

  createdAt DateTime @default(now())

  members JourneyMember[]
  intents JourneyPrayerIntent[]

}

model JourneyPrayerIntent {

  id String @id @default(uuid())

  journeyId String

  userId String

  text String

  weekKey String

  createdAt DateTime @default(now())

  journey PrayerJourney @relation(fields: [journeyId], references: [id], onDelete: Cascade)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

}

enum JourneyRole {

  OWNER

  MEMBER

}

enum PaymentMethod {
  CASH
  CREDIT_CARD
  DEBIT_CARD
  BANK_TRANSFER
  PIX
  OTHER
}

enum Category {
  FOOD
  TRANSPORT
  ENTERTAINMENT
  HEALTH
  BILLS
  EDUCATION
  TRAVEL
  RENT
  SHOPPING
  INVESTMENTS
  SUBSCRIPTIONS
  OTHER
}
